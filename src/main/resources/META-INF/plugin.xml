<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>io.github.litscoped.scoped-elements</id>
    <name>Lit Scoped Elements</name>
    <vendor>lit-scoped-elements</vendor>

    <description><![CDATA[
    Lit and Open WC scoped elements: navigation, inspections, and completion for
    <a href="https://lit.dev">Lit</a> components using
    <a href="https://open-wc.org/docs/development/scoped-elements/">Open WC scoped elements</a>, and their events.
    <ul>
      <li><b>Navigation</b>: from a tag in an <code>html`...`</code> template to the class registered in
          <code>scopedElements</code> (or globally), from a <code>scopedElements</code> key to the templates using it,
          and between <code>@my-event</code> bindings, <code>addEventListener</code>, and the code firing the event.
          Gutter icons for the same links.</li>
      <li><b>Find Usages and Rename</b> of <code>scopedElements</code> keys, updating the tags in templates.</li>
      <li><b>Completion</b> of scoped tag names, of the events an element fires, and of its reactive properties
          (<code>.prop</code>, <code>attribute</code>, and <code>?attribute</code>).</li>
      <li><b>Quick documentation</b> on a tag: the class it resolves to and where it is registered.</li>
      <li><b>Inspections</b>: elements missing from <code>scopedElements</code> (the quick fix adds the entry and the
          import), unused entries, events listened to but never fired, and events fired but never listened to.</li>
    </ul>
    Understands field and getter declarations, spreads, inheritance (mixins included), templates rendered by
    functions outside the class, <code>customElements.define</code> and <code>@customElement</code>, event helper
    calls, and <code>Event</code> subclasses, in JavaScript and TypeScript.
    Settings: <i>Settings | Languages &amp; Frameworks | Lit Scoped Elements</i>.
    ]]></description>

    <resource-bundle>messages.LitBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>JavaScript</depends>

    <applicationListeners>
        <listener class="io.github.litscoped.EventSourcesTrustListener"
                  topic="com.intellij.ide.trustedProjects.TrustedProjectsListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="io.github.litscoped.LitIndex"/>
        <additionalLibraryRootsProvider implementation="io.github.litscoped.EventSourcesLibraryProvider"/>
        <referencesSearch implementation="io.github.litscoped.ScopedTagReferenceSearcher"/>
        <completion.contributor language="any" order="first"
                                implementationClass="io.github.litscoped.ScopedTagCompletionContributor"/>
        <completion.contributor language="any" order="first"
                                implementationClass="io.github.litscoped.ScopedEventCompletionContributor"/>
        <completion.contributor language="any" order="first"
                                implementationClass="io.github.litscoped.PropertyCompletionContributor"/>
        <codeInsight.lineMarkerProvider language="JavaScript"
                                        implementationClass="io.github.litscoped.JsLitLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="HTML"
                                        implementationClass="io.github.litscoped.TemplateEventLineMarkerProvider"/>
        <platform.backend.documentation.targetProvider order="first"
                                                       implementation="io.github.litscoped.ScopedTagDocumentationTargetProvider"/>
        <renamePsiElementProcessor order="first"
                                   implementation="io.github.litscoped.ScopedElementKeyRenameProcessor"/>
        <projectConfigurable parentId="language"
                             instance="io.github.litscoped.LitSettingsConfigurable"
                             id="io.github.litscoped.settings"
                             key="settings.display.name"/>

        <gotoDeclarationHandler order="first"
                                implementation="io.github.litscoped.ScopedElementGotoDeclarationHandler"/>
        <gotoDeclarationHandler order="first"
                                implementation="io.github.litscoped.LitEventGotoDeclarationHandler"/>
        <gotoDeclarationHandler order="first"
                                implementation="io.github.litscoped.ScopedElementUsagesGotoHandler"/>

        <localInspection language="JavaScript"
                         applyToDialects="true"
                         shortName="LitMissingScopedElement"
                         key="inspection.missing.display.name"
                         groupPath="JavaScript and TypeScript"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.litscoped.MissingScopedElementInspection"/>
        <localInspection language="JavaScript"
                         applyToDialects="true"
                         shortName="LitUnusedScopedElement"
                         key="inspection.unused.display.name"
                         groupPath="JavaScript and TypeScript"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.litscoped.UnusedScopedElementInspection"/>
        <localInspection language="JavaScript"
                         applyToDialects="true"
                         shortName="LitUnknownEvent"
                         key="inspection.unknown.event.display.name"
                         groupPath="JavaScript and TypeScript"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="io.github.litscoped.UnknownEventInspection"/>
        <localInspection language="JavaScript"
                         applyToDialects="true"
                         shortName="LitUnheardEvent"
                         key="inspection.unheard.event.display.name"
                         groupPath="JavaScript and TypeScript"
                         groupKey="inspection.group.name"
                         enabledByDefault="false"
                         level="WEAK WARNING"
                         implementationClass="io.github.litscoped.UnheardEventInspection"/>
    </extensions>

    <!-- Development only: present in builds made with -Pscreenshots (see build.gradle.kts). -->
    <xi:include href="/META-INF/screenshots.xml" xpointer="xpointer(/idea-plugin/*)">
        <xi:fallback/>
    </xi:include>
</idea-plugin>
